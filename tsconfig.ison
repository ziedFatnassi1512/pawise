{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode setup mapping options */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Clean Path Alias Mapping Configuration Matrix */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    /* Linting configuration options matrix */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "fallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
